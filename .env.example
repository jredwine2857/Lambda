# Copy to .env and fill in, then `source .env` before running infra scripts.

LAMBDA_API_KEY=your_api_key_here

# Name of the SSH key as it appears in your Lambda Cloud account (Cloud dashboard > SSH keys)
SSH_KEY_NAME=your-ssh-key-name

# Run `infra/lambda_cloud_api.sh list-types` after setting LAMBDA_API_KEY to see what's
# in stock in which region. gpu_1x_a10 (1x A10 24GB) was $1.29/hr as of 2026-09-15 —
# the cheapest single-GPU SKU Lambda offers, so x2 nodes = ~$2.58/hr for this whole lab.
# Confirm current pricing in the Cloud dashboard before launching; it does change.
INSTANCE_TYPE=gpu_1x_a10
REGION=us-east-1

# Filled in automatically by infra/launch_cluster.sh
NODE0_IP=
NODE1_IP=
NODE0_ID=
NODE1_ID=
